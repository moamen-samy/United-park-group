# GEMINI_API_KEY: Required for Gemini AI API calls (injected by AI Studio Secrets if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public base URL of the deployed Cloud Run / AI Studio service.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL runtime variables (injected automatically in AI Studio / Cloud Run)
SQL_HOST="127.0.0.1"
SQL_DB_NAME="park_corporate"
SQL_USER="app_user"
SQL_PASSWORD="change_me"

# Cloud SQL PostgreSQL admin credentials (used strictly by drizzle-kit migrations)
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="change_me"

# Optional Email Notification Webhook / SMTP relay for RFQ alerts
RFQ_NOTIFICATION_WEBHOOK_URL=""
RFQ_NOTIFICATION_EMAIL="info@park.com.sa"

# Admin bootstrap emails (comma-separated Google account emails granted super_admin on first sign-in)
ADMIN_BOOTSTRAP_EMAILS=""
